# Website
NEXT_PUBLIC_SITE_URL=https://www.minmurasu.digital

# Analytics (load only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# Contact form lead delivery (Gmail SMTP)
# 1. Turn on 2-Step Verification for the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces) — never commit the real value
GMAIL_USER=minmurasu.digital@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=minmurasu.digital@gmail.com

# Lead store (Postgres: Supabase / Neon). Run db/migrations/001_leads.sql first.
# Supabase: use the transaction pooler URL (port 6543). If unset, leads are emailed only.
DATABASE_URL=

# Shared rate limiting + duplicate detection across serverless instances (upstash.com)
# If unset, an in-memory fallback is used (OK locally, ineffective on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signed lead webhook (n8n Webhook node URL). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# n8n verifies X-MinMurasu-Signature = sha256=HMAC_SHA256(secret, `${X-MinMurasu-Timestamp}.${rawBody}`)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# WhatsApp
WHATSAPP_NUMBER=919486772206
